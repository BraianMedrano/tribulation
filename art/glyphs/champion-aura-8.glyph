# tribulation — Champion aura: golden orbiting spark, 8px particle.
# Two flicker variants the particle alternates between while it circles the
# champion: a four-point star with a pale-hot core, and a smaller glint. Gold is
# the shared metal tone, so champions read as "special" without borrowing the
# red threat ramp. The particle is full-bright and fades in code.
size: 8
kind: particle
frames: split
frametime: 3
ships: src/main/resources/assets/tribulation/textures/particle/champion_aura.png

legend:
  . transparent
  W bone+2               # pale-hot core
  Y metal.gold           # gold body
  o metal.gold-1         # deep gold edge

# star
frame:
  ........
  ...Y....
  ...Y....
  .YYWYY..
  ...Y....
  ...Y....
  ........
  ........

# glint
frame:
  ........
  ........
  ...o....
  ..oWo...
  ...o....
  ........
  ........
  ........
