{
    "schemaVersion": 1,
    "id": "tribulation",
    "version": "${version}",
    "name": "Tribulation",
    "description": "A comprehensive difficulty overhaul for Minecraft. Formula-driven mob scaling across time, distance, height, and moon-phase axes with opt-in death penalties and hardcore mechanics.",
    "authors": ["rfizzle"],
    "contact": {
        "homepage": "https://tribulation.rfizzle.com",
        "sources": "https://github.com/rfizzle/tribulation",
        "issues": "https://github.com/rfizzle/tribulation/issues"
    },
    "license": "MIT",
    "icon": "assets/tribulation/icon.png",
    "environment": "*",
    "entrypoints": {
        "main": ["com.rfizzle.tribulation.Tribulation"],
        "client": ["com.rfizzle.tribulation.client.TribulationClient"],
        "fabric-datagen": ["com.rfizzle.tribulation.data.TribulationDataGenerator"],
        "modmenu": ["com.rfizzle.tribulation.compat.modmenu.ModMenuIntegration"],
        "jade": ["com.rfizzle.tribulation.compat.jade.JadeTribulationPlugin"],
        "rei_client": ["com.rfizzle.tribulation.compat.rei.ReiShardPlugin"],
        "jei_mod_plugin": ["com.rfizzle.tribulation.compat.jei.JeiShardPlugin"]
    },
    "suggests": {
        "modmenu": "*",
        "cloth-config": "*",
        "jade": "*",
        "wthit": "*",
        "emi": "*",
        "roughlyenoughitems": "*",
        "jei": "*",
        "meridian": "*"
    },
    "mixins": [
        "tribulation.mixins.json",
        {
            "config": "tribulation.client.mixins.json",
            "environment": "client"
        }
    ],
    "depends": {
        "fabricloader": ">=0.20.1",
        "minecraft": "~26.3",
        "java": ">=25",
        "fabric-api": "*"
    }
}
